# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Build outputs
dist/
build/
frontend/dist/
frontend/build/

# WASM build outputs
frontend/pkg/
backend/pkg/
backend/target/

# Rust
# Cargo.lock is committed — this is a binary/WASM cdylib, not a library crate,
# so we want reproducible builds of the deployed artifact.
**/*.rs.bk
*.pdb

# Environment variables
.env
.env.local
.env.*.local

# Editor directories and files
.vscode/
.idea/
.pi/
.pi-lens/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/

# Temporary files
*.tmp
*.temp
.cache/

# OS files
Thumbs.db
.DS_Store

# Package manager
yarn.lock
pnpm-lock.yaml

# TypeScript
*.tsbuildinfo

# Build artifacts
*.wasm.map

.planning/
docs/
ARCHITECTURE.md
GEMINI.md
limit-test.md
REFACTORING_CHECKLIST.md
REFACTORING_REPORT.md
ROADMAP.md

# Local Virtual Wind demonstrator (throwaway, not part of the app)
vw-demo/

# Claude Code local state — also holds agent worktrees under .claude/worktrees/,
# which must never be swept into a commit by a stray `git add -A`.
.claude/
/scripts/deploy-s3.sh
