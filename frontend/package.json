{
  "name": "virtual-elevation-analyzer-frontend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"*.config.ts\" && tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit && knip --include files --no-progress",
    "knip": "knip --no-progress",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"*.config.ts\"",
    "lint": "eslint src scripts vite.config.ts vitest.config.ts --max-warnings=0",
    "test": "vitest run",
    "profile:slider": "vite-node scripts/profile-slider-recompute.ts",
    "profile:gps-lap-render": "vite-node scripts/profile-gps-lap-render.ts",
    "profile:out-and-back": "vite-node scripts/profile-out-and-back-aggregation.ts"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "browser-fs-access": "^0.38.0",
    "leaflet": "^1.9.4",
    "plotly.js-basic-dist": "^2.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^25.5.2",
    "eslint": "^9.39.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.4.0",
    "jsdom": "^29.0.2",
    "knip": "^6.35.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.0.7",
    "vitest": "^3.2.4"
  }
}
